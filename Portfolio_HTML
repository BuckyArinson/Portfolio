            letter-spacing: 0.04em;
        }
        body.loaded {
            opacity: 1;
        }

        /* Subtle monitor grain overlay for faded CRT vibe */
        body::after {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(16, 18, 22, 0) 50%, rgba(0, 0, 0, 0.15) 50%);
            z-index: 999;
            background-size: 100% 4px;
            pointer-events: none;
            opacity: 0.6;
