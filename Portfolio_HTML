        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #101216; }
        ::-webkit-scrollbar-thumb { background: #323946; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #ff6600; }

        .hud-box {
            position: relative;
            background: #191c24;
            border: 1px solid #323946;
            transition: border-color 0.3s ease;
        }
        .hud-box:hover {
            border-color: #ff6600;
        }
        .hud-box::before {
            content: '';
            position: absolute;
            top: -1px; left: -1px;
            width: 8px; height: 8px;
            border-top: 2px solid #ff6600;
            border-left: 2px solid #ff6600;
            pointer-events: none;
        }
        .hud-box::after {
            content: '';
            position: absolute;
            bottom: -1px; right: -1px;
            width: 8px; height: 8px;
            border-bottom: 2px solid #ff6600;
            border-right: 2px solid #ff6600;
            pointer-events: none;
        }

        .modal-backdrop {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s linear;
        }
        .modal-backdrop.active {
            opacity: 1;
            visibility: visible;
        }
        .modal-container {
            transform: scale(0.95);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .modal-backdrop.active .modal-container {
            transform: scale(1);
        }
    </style>
